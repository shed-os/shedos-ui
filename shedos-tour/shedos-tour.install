post_install() {
    systemctl --global enable shedos-tour.service 2>/dev/null || true
    systemctl --global enable shedos-recovery-key.service 2>/dev/null || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl --global disable shedos-tour.service 2>/dev/null || true
    systemctl --global disable shedos-recovery-key.service 2>/dev/null || true
}
