# Maintainer: ShedOS <https://github.com/theshedman/shedos>
#
# Animated screensaver subsystem (Rust). One binary,
# /usr/bin/shedos-screensaver, with a TTY backend (crossterm) and a
# Wayland-native fullscreen overlay backend (smithay-client-toolkit
# + wgpu). Eight styles ship in the initial release; per-style
# typed options; optional pipewire audio reactivity; wallpaper
# compositing in Wayland mode; fluent-rs i18n.
#
# Stage 2 ships the workspace skeleton: shedos-screensaver-core
# (Frame/Color/Clock/Logo/Catppuccin), shedos-screensaver-i18n
# (fluent wrapper + en-US catalog), and the CLI binary stub
# (--help/--list/--help-style/--complete-{bash,zsh,fish}/--version
# plus full --style/--color/--style-opt validation).
# Renderer crates and styles land in subsequent stages.

pkgname=shedos-screensaver
pkgver=2026.04.27
pkgrel=1
pkgdesc='Animated screensaver: TTY + Wayland backends, 8 styles, audio-reactive'
arch=('x86_64')
url='https://github.com/theshedman/shedos'
license=('GPL-3.0-or-later')
depends=(
    'gcc-libs'              # rust runtime
    'glibc'
    'shedos-branding'       # /etc/shedos-ascii.txt
    'wayland'               # libwayland-client.so.0 (Wayland renderer)
    'libxkbcommon'          # crossterm + smithay keyboard handling
    'ttf-dejavu'            # default DejaVu Sans Mono for the Wayland font atlas
    'alsa-lib'              # cpal -> ALSA -> pipewire-alsa loopback (audio capture)
)
makedepends=(
    'rust>=1.75'            # workspace builds against rust 2021 edition
    'cargo'
    'scdoc'                 # man page render
    'pkgconf'               # cpal probes alsa via pkg-config
)
backup=(
    'etc/shedos/screensaver.toml'
)

prepare() {
    # Render man pages.
    cd "$startdir"
    install -d man/build
    for src in man/*.scd; do
        out=man/build/$(basename "${src%.scd}")
        scdoc < "$src" > "$out"
    done
}

build() {
    cd "$startdir"
    # `--frozen` enforces the vendored Cargo.lock; drop it for the
    # first time the lockfile is generated, then re-add. CI uses
    # --frozen to catch unexpected dep updates.
    cargo build --release --locked --workspace
}

check() {
    cd "$startdir"
    cargo test --release --locked --workspace
}

package() {
    cd "$startdir"

    # Binary.
    install -Dm755 target/release/shedos-screensaver \
        "$pkgdir/usr/bin/shedos-screensaver"

    # shedman dispatcher shim.
    install -Dm755 tree/usr/libexec/shedman/screensaver \
        "$pkgdir/usr/libexec/shedman/screensaver"

    # Backed-up default config.
    install -Dm644 tree/etc/shedos/screensaver.toml \
        "$pkgdir/etc/shedos/screensaver.toml"

    # Man page.
    install -Dm644 man/build/shedman-screensaver.1 \
        "$pkgdir/usr/share/man/man1/shedman-screensaver.1"

    # i18n catalog (embedded fallback also baked into the binary,
    # but ship the file so users can copy/translate it).
    install -Dm644 i18n/en-US.ftl \
        "$pkgdir/usr/share/locale/en/LC_MESSAGES/shedos-screensaver.ftl"

    # Documentation.
    install -d "$pkgdir/usr/share/doc/shedos-screensaver"
    install -m644 tree/usr/share/doc/shedos-screensaver/hypridle-example.conf \
        "$pkgdir/usr/share/doc/shedos-screensaver/hypridle-example.conf"
    install -m644 tree/usr/share/doc/shedos-screensaver/effects.md \
        "$pkgdir/usr/share/doc/shedos-screensaver/effects.md"
    install -m644 tree/usr/share/doc/shedos-screensaver/logos.md \
        "$pkgdir/usr/share/doc/shedos-screensaver/logos.md"
    install -m644 tree/usr/share/doc/shedos-screensaver/audio-setup.md \
        "$pkgdir/usr/share/doc/shedos-screensaver/audio-setup.md"

    # Shell completions — generated by the just-built binary so they
    # always match the live argparse. Each --complete-* flag emits the
    # native completion script for that shell on stdout.
    install -d "$pkgdir/usr/share/bash-completion/completions"
    install -d "$pkgdir/usr/share/zsh/site-functions"
    install -d "$pkgdir/usr/share/fish/vendor_completions.d"
    target/release/shedos-screensaver --complete-bash \
        > "$pkgdir/usr/share/bash-completion/completions/shedos-screensaver"
    target/release/shedos-screensaver --complete-zsh \
        > "$pkgdir/usr/share/zsh/site-functions/_shedos-screensaver"
    target/release/shedos-screensaver --complete-fish \
        > "$pkgdir/usr/share/fish/vendor_completions.d/shedos-screensaver.fish"
}
