[Unit]
Description=ShedOS lock screen (ext-session-lock-v1 client)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Clear hypridle's idle-dim shader before the lock surface renders;
# without this the screensaver and prompt sit behind the dim until
# user input fires hypridle's on-resume.
ExecStartPre=-/usr/bin/hyprshade off
ExecStart=/usr/bin/shedos-screensaver --mode=lock
Restart=on-failure
# Respawn fast: the session stays input-locked while the client is gone,
# so a long delay only prolongs the stale frame the compositor shows.
RestartSec=200ms
StartLimitBurst=5
StartLimitIntervalSec=60
