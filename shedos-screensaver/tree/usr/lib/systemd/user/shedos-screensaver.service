[Unit]
# Started by hypridle's listener hooks. No [Install] because
# WantedBy= would pull this up at login and render an overlay over
# an active session.
Description=ShedOS animated screensaver
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/shedos-screensaver --mode=wayland --idle-daemon --hold 5
# SIGUSR1 is the screensaver binary's clean-exit signal.
KillSignal=SIGUSR1
TimeoutStopSec=5
Restart=no
