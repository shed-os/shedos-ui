# Maintainer: ShedOS <https://github.com/Theshedman/shedos>
#
# Fullscreen overlay the Waybar power glyph opens. Same renderer
# family as shedos-greeter; uses wlr-layer-shell for the overlay
# surface and shedos-prompt-ui for font + primitives.

pkgname=shedos-power
pkgver=2026.08.09
pkgrel=1
pkgdesc='ShedOS power-menu overlay'
arch=('x86_64')
url='https://github.com/Theshedman/shedos'
license=('GPL-3.0-or-later')

depends=(
    'gcc-libs'
    'glibc'
    'wayland'
    'libxkbcommon'
    'ttf-jetbrains-mono-nerd'
    'shedos-system'
)

makedepends=(
    'cargo'
    'scdoc'
)

source=("git+https://github.com/shed-os/shedos-ui.git#tag=$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/shedos-ui/shedos-power"
    install -d man/build
    for src in man/*.scd; do
        out=man/build/$(basename "${src%.scd}")
        scdoc < "$src" > "$out"
    done
}

build() {
    cd "$srcdir/shedos-ui/shedos-power"
    cargo build --release --locked
}

check() {
    cd "$srcdir/shedos-ui/shedos-power"
    cargo test --release --locked
}

package() {
    cd "$srcdir/shedos-ui/shedos-power"

    install -Dm755 "$srcdir/shedos-ui/target/release/shedos-power" \
        "$pkgdir/usr/bin/shedos-power"

    install -Dm644 man/build/shedos-power.1 \
        "$pkgdir/usr/share/man/man1/shedos-power.1"
}
